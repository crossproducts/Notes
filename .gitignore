# Local secret files — never commit
**/.env
**/.env.local
**/*.secret

# Claude Code per-machine settings
.claude/settings.local.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE — settings.json is shared (draw.io plugin wiring)
.vscode/*
!.vscode/settings.json
.idea/

# Obsidian (vault opened at repo root) — keep per-machine state out of git
.obsidian/workspace*
.obsidian/cache
.obsidian/plugins/*/data.json
*.swp
*.swo

# Logs (e.g. claude-run.log from launch/retry loops)
*.log

# Python bytecode
__pycache__/
*.pyc

# EDGAR response cache (runtime artifact)
.edgar_cache/

# Video-pipeline cache: media is large and fully regenerable from the URL in
# sources.yaml. The RESEARCH OUTPUT (transcripts, interpreted strategies,
# segments) is small and is deliberately kept under version control.
.labs/audio-extraction/cache/*.mp3
.labs/audio-extraction/cache/*.mp4
.labs/audio-extraction/cache/*.wav
.labs/audio-extraction/cache/*_frames/

# Playwright persistent context for an authenticated Instagram session
# (discover.py --ig-profile-dir). Contains live session cookies - never commit.
.labs/audio-extraction/.ig-profile/
