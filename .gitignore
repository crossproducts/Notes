# Local secret files — never commit
**/.env
**/.env.local
**/*.secret

# Claude Code per-machine settings
.claude/settings.local.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE — settings.json is shared (draw.io plugin wiring)
.vscode/*
!.vscode/settings.json
.idea/

# Obsidian (vault opened at repo root) — keep per-machine state out of git
.obsidian/workspace*
.obsidian/cache
.obsidian/plugins/*/data.json
*.swp
*.swo

# Logs (e.g. claude-run.log from launch/retry loops)
*.log

# Python bytecode
__pycache__/
*.pyc

# EDGAR response cache (runtime artifact)
.edgar_cache/

# Video-pipeline cache: media is large and fully regenerable from the URL in
# sources.yaml. The RESEARCH OUTPUT (transcripts, interpreted strategies,
# segments) is small and is deliberately kept under version control.
.labs/audio-extraction/cache/*.mp3
.labs/audio-extraction/cache/*.mp4
.labs/audio-extraction/cache/*.wav
.labs/audio-extraction/cache/*_frames/

# Playwright persistent context for an authenticated Instagram session
# (discover.py --ig-profile-dir). Contains live session cookies - never commit.
.labs/audio-extraction/.ig-profile/

# ---------------------------------------------------------------------------
# Infrastructure credentials, state and caches.
#
# Repo-wide ON PURPOSE. .labs/AWS/floci-eks/ already ships its own .gitignore
# covering these, and it is holding - nothing credential-shaped has ever been
# committed. But that protection is one file deep: the next IaC lab that lands
# without its own .gitignore would commit a live cluster credential on the
# first `git add -A`. These rules make the safe case the default.
kubeconfig
kubeconfig.*
.kube/
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl.bak
.terraform.tfstate.lock.info
.terragrunt-cache/

# Terraform/terragrunt vendor the AWS provider binary into .terraform/ - it is
# 628 MB per module here, and fully re-fetchable with `terraform init`.
terraform-provider-*
*_x5.exe

# Private keys, cert bundles and cloud CLI credentials. If a lab ever needs a
# throwaway sample key under version control (e.g. .labs/tls-crypto fixtures),
# add it deliberately with `git add -f` rather than loosening this.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.aws/credentials
.netrc

# Explainer-video lab: TTS model weights (~340 MB, re-downloadable from the
# kokoro-onnx release) and the per-scene build intermediates.
# The finished MP4 is deliberately NOT ignored -- being able to open it from
# the repo is the whole point of rendering it. Each rebuild adds another ~17 MB
# blob to history permanently, so if this grows past a few decks, move the
# videos to Git LFS rather than letting the pack balloon.
.labs/explainer-video/models/
.labs/explainer-video/out/.work/
.labs/explainer-video/out/preview.png
