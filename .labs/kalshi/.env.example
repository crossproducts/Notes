# Kalshi API credentials. Not read by anything yet — the analytical core is
# offline by design. Needed from roadmap step 1 (ingest) onward.
#
# Create a key under Profile Settings > API Keys. Demo and production may need
# SEPARATE keys and separate base URLs — verify against the official docs
# before use; third-party guides disagree (see README "Open piece: ingest").
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi-private-key.pem

# Start on demo. Do not point this at production until a series has passed
# screen_series AND a paper period.
KALSHI_ENV=demo
