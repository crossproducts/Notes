# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Alpaca (stocks/options/crypto) — same keys as .labs/audio-extraction
ALPACA_API_KEY=xxx
ALPACA_SECRET_KEY=xxx

# OANDA (forex) — free practice account: https://www.oanda.com
OANDA_API_KEY=xxx
OANDA_ACCOUNT_ID=xxx

# Quiver Quantitative (congress trades) — optional, paid API
QUIVER_API_KEY=xxx

# Nightly SMS notifications (same values as .labs/email-sender/.env)
GMAIL_ADDRESS=xxx
GMAIL_APP_PASSWORD=xxx
DEFAULT_RECIPIENT=xxx   # e.g. 5551234567@tmomail.net
