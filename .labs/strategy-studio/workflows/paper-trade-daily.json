{
  "id": "PaperTradeQQQDaily",
  "name": "Paper Trade — QQQ champion daily",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "35 9 * * 1-5" }
          ]
        }
      },
      "id": "trig-cron-paper-01",
      "name": "Market days 9:35",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {},
      "id": "trig-exec-paper-01",
      "name": "Manual Run",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/paper/execute/QQQ",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "position_pct", "value": "10" }
          ]
        },
        "options": { "timeout": 300000 }
      },
      "id": "http-paper-exec-01",
      "name": "Execute Champion Signal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/notify",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '[paper] ' + $json.symbol + ' ' + $json.action + ' (' + $json.champion_strategy + ', signal ' + $json.signal_today + ') equity $' + $json.account_equity }) }}",
        "options": { "timeout": 60000 }
      },
      "id": "http-paper-sms-01",
      "name": "SMS Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Market days 9:35": {
      "main": [[{ "node": "Execute Champion Signal", "type": "main", "index": 0 }]]
    },
    "Manual Run": {
      "main": [[{ "node": "Execute Champion Signal", "type": "main", "index": 0 }]]
    },
    "Execute Champion Signal": {
      "main": [[{ "node": "SMS Action", "type": "main", "index": 0 }]]
    }
  },
  "settings": {}
}
